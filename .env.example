# Asthma RAG pipeline — environment variables
# Copy this file to .env and fill in your keys. Never commit .env.

# Groq — LLM inference (fast cloud inference)
GROQ_API_KEY=
# Optional: override the chat model (default: openai/gpt-oss-120b)
# GROQ_MODEL=

# Cohere — reranking
COHERE_API_KEY=

# Hugging Face — local models cache (optional; defaults to ~/.cache/huggingface)
HF_HOME=

# Embedding backend: "local" (sentence-transformers, CPU) or "ollama" (GPU server)
EMBEDDING_BACKEND=local
# Ollama embedding server (only used when EMBEDDING_BACKEND=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBEDDING_MODEL=qwen3-embedding:0.6b

# EXA — web search (drug prices in Egypt + how-to videos)
EXA_API_KEY=

# Langfuse — observability (leave empty to disable; pipeline runs unaffected)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_TRACING_ENABLED=true

# Agent LLM roles (optional overrides)
# VERIFIER_MODEL=openai/gpt-oss-20b
# JUDGE_MODEL=openai/gpt-oss-120b

# Groq audio (optional overrides)
# STT_MODEL=whisper-large-v3-turbo
# TTS_MODEL=canopylabs/orpheus-v1-english
# TTS_VOICE=troy

# Web search tuning (optional)
# SEARCH_MAX_RESULTS=5
# SEARCH_MAX_AGE_HOURS=24
